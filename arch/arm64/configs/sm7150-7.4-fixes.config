# sm7150 7.1 -> 7.4-rc2 Kconfig fixes (renamed/removed/new symbols).
# Merge after arch/arm64/configs/sm7150.config, before phase1-camera-off.config.
# Analysis: base = config-postmarketos-qcom-sm7150.aarch64 + sm7150.config
# @ sweet-7.1-working; reference final config = /boot/config from
# linux-postmarketos-qcom-sm7150-7.1.0-r5.apk (clang 23.1.4);
# new tree = v7.4-rc2 + downstream (checked against sim/7.4-rc2).

# --- New gate: f2866e6a27f7 "soc: qcom: Hide all drivers behind selectable menu"
# Every drivers/soc/qcom driver (SMEM, SMP2P, RPMH, COMMAND_DB, GENI_SE, AOSS_QMP,
# APR, LLCC, OCMEM, RMTFS_MEM, SOCINFO, PD_MAPPER, PMIC_GLINK, ...) is now inside
# "if QCOM_SOC". It defaults to ARCH_QCOM, so olddefconfig should pick y, but if
# it ever ends up n the phone does not boot (GENI UART/I2C/SPI, RPMh clocks and
# regulators, remoteprocs, ath10k, BT, audio, venus all cascade off). Pin it.
CONFIG_QCOM_SOC=y

# --- Renamed: CRYPTO_DEV_QCOM_RNG -> HW_RANDOM_QCOM
# 6727c44461f7 "hwrng: qcom - Move qcom-rng.c into drivers/char/hw_random/"
# (sm7150.dtsi has no prng node, so this is parity only.)
CONFIG_HW_RANDOM_QCOM=m

# --- Removed: PROC_SYSCTL (8d75c338f0bc, folded into SYSCTL). SYSCTL=y already
# in the base config; nothing to set.

# --- Renamed: DEBUG_WX -> CHECK_WX (2e83e2ce34ff). Old value was "not set".
# CHECK_WX now defaults to STRICT_KERNEL_RWX (=y), so it turns ON: a one-shot
# "Checked W+X mappings" boot message, harmless. Left at upstream default.
# To keep strict 7.1 parity instead, add the line
#   "# CONFIG_CHECK_WX is not set"

# --- QCE is now "depends on (BROKEN && ARCH_QCOM) || COMPILE_TEST".
# sm7150.config still says CRYPTO_DEV_QCE=y; olddefconfig would silently drop it
# (and _SKCIPHER/_SHA/_AEAD/_ENABLE_ALL). Say so explicitly. No QCE node in
# sm7150.dtsi, so no functional loss. (ICE / UFS inline crypto is unaffected.)
# CONFIG_CRYPTO_DEV_QCE is not set

# --- Removed: ANDROID_BINDER_IPC (C binder deleted; 315860c4f912). Only
# ANDROID_BINDER_IPC_RUST remains and it depends on RUST, which is off.
# => No binder => Waydroid/Anbox cannot work on this kernel until Rust is
# enabled. Nothing settable here. pmaports kconfigcheck (category:waydroid,
# part of pmb:kconfigcheck-community) will flag ANDROID_BINDER_IPC; the check
# is not run by "pmbootstrap build".

# --- Removed with no action needed (auto-selected or were off):
# ARM64_WORKAROUND_REPEAT_TLBI -> ARM64_WORKAROUND_REPEAT_TLBI_SYNC (select)
# HAVE_GENERIC_VDSO -> VDSO_DATASTORE (select)
# ARCH_ENABLE_THP_MIGRATION -> ARCH_HAS_PMD_SOFTLEAVES (select)
# ARCH_HAS_DEBUG_WX -> ARCH_HAS_CHECK_WX (select)
# PER_VMA_LOCK, ARCH_SUPPORTS_PER_VMA_LOCK (now unconditional)
# MMU_GATHER_RCU_TABLE_FREE, MMU_GATHER_TABLE_FREE, HAVE_PREEMPT_DYNAMIC(_KEY)
# QCOM_TZMEM_MODE_GENERIC (choice removed; QCOM_TZMEM_MODE_SHMBRIDGE=y kept)
# CACHEFILES_ONDEMAND, DMA_FENCE_TRACE, RUSTC_SUPPORTS_ARM64, BFS_FS, EFS_FS,
# VXFS_FS, LLC2, MMC_VUB300, HID_KYSONA, HISI_HIKEY_USB, CRYPTO_DEV_HISI_SEC,
# TEST_BPF, RANDOM32_SELFTEST, DEBUG_FORCE_WEAK_PER_CPU, ANDROID_BINDERFS,
# VIDEO_MAX96712, VIDEO_MAX96714 (all were n)

# --- Tidy-up (ACTIVE; delete this block if unwanted): Qualcomm drivers for
# other SoCs that are NEW in 7.3/7.4 and default to y/m on ARCH_QCOM
# (sm7150.config already disables the older ones of the same kind). Harmless if
# left on; disabling only saves size/build time. None is used by sm7150.
# CONFIG_CLK_SHIKRA_GCC is not set
# CONFIG_CLK_SHIKRA_AUDIOCORECC is not set
# CONFIG_MSM_GCC_8952 is not set
# CONFIG_CLK_ELIZA_CAMCC is not set
# CONFIG_CLK_ELIZA_GPUCC is not set
# CONFIG_CLK_ELIZA_VIDEOCC is not set
# CONFIG_CLK_GLYMUR_CAMCC is not set
# CONFIG_CLK_GLYMUR_EVACC is not set
# CONFIG_CLK_HAWI_CAMCC is not set
# CONFIG_CLK_HAWI_GPUCC is not set
# CONFIG_CLK_HAWI_VIDEOCC is not set
# CONFIG_CLK_MAILI_VIDEOCC is not set
# CONFIG_CLK_NORD_CAMCC is not set
# CONFIG_CLK_NORD_DISPCC is not set
# CONFIG_CLK_NORD_GPUCC is not set
# CONFIG_CLK_NORD_VIDEOCC is not set
# CONFIG_INTERCONNECT_QCOM_MAILI is not set
# CONFIG_PINCTRL_MAILI is not set
# CONFIG_PINCTRL_MSM8952 is not set
